# MongoDB Connection URI (Atlas connection string)
# IMPORTANT FOR DEPLOYMENT: In MongoDB Atlas -> Network Access, add IP 0.0.0.0/0 to allow connections from cloud hosts
DBURL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/luxe_atelier?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Payment Gateway Credentials (Test or Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# Server Port (Cloud platforms like Render/Railway set this automatically)
PORT=8000

# Client Frontend URL for CORS (e.g., https://your-shopkart.vercel.app or comma-separated list)
CLIENT_URL=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=production
