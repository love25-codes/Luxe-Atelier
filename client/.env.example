# Backend API Base URL
# - For local development: http://localhost:8000
# - For separate production deployment (e.g. Vercel frontend calling Render backend):
#   Set this to your live backend URL (e.g. https://shopkart-backend.onrender.com)
# - For unified hosting (backend Express server serves client build): leave blank
VITE_API_BASE_URL=http://localhost:8000
